---
// Header: wordmark left, the whole site right. No menu overlay — every
// destination is a link in the bar (2026-08-14), so nothing is one tap away
// from being one tap away.
// The wordmark is unaccented on purpose: every character of "Pyrenees
// Pictures Studio" exists in the licensed cut, so nothing falls back.
interface Props { path: string }
const { path } = Astro.props;
const isWork = path.startsWith('/works') || path.startsWith('/archive');
const isStudio = path.startsWith('/about');
const isPrice = path.startsWith('/contact');
---
<header class="hd">
  <a class="hd__logo u-micro" href="/">
    <span class="hd__full">Pyrenees Pictures Studio</span>
    <span class="hd__short">Pyrenees</span>
  </a>

  <nav class="hd__nav u-micro" aria-label="Site">
    <a href="/works" class:list={[{ 'is-on': isWork }]}>Work</a>
    <a href="/about" class:list={[{ 'is-on': isStudio }]}>Studio</a>
    <a href="/contact" class:list={[{ 'is-on': isPrice }]}>Contact</a>
    <!-- One label, not a pair: it reads as the language you are in, and
         tapping it hands you the other one. -->
    <button class="hd__lang" id="langBtn" type="button">
      <span class="t-en">EN</span><span class="t-ja">JA</span>
    </button>
  </nav>
</header>

<style>
  .hd {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px var(--pad-inline);
    pointer-events: none;
  }
  .hd > * { pointer-events: auto; }
  .hd__logo { letter-spacing: var(--ls-global); white-space: nowrap; }
  .hd__short { display: none; }

  .hd__nav {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 2.2vw, 34px);
    white-space: nowrap;
  }
  /* colour carries no state on this site (the grey tier is retired), so the
     current page holds a hairline underline instead */
  .hd__nav > a {
    color: var(--color-ink);
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }
  .hd__nav > a.is-on,
  .hd__nav > a:hover { text-decoration-line: underline; }
  .hd__nav > a:hover:not(.is-on) { text-decoration-color: var(--line); }
  .hd__lang { color: var(--color-ink); }
  .hd__lang:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* the bar carries four items now, so the wordmark gives way first */
  @media (max-width: 720px) {
    .hd { gap: 10px; }
    .hd__full { display: none; }
    .hd__short { display: inline; }
    .hd__nav { gap: 12px; font-size: 11px; }
  }
  @media (max-width: 420px) {
    .hd__nav { gap: 9px; font-size: 10px; }
  }
</style>

---
import archive from '../data/archive.json';

// Site menu — the catalogue study, promoted. Destinations are set in display
// size and read as a printed index; a small window follows the pointer and
// shows what is behind whichever line is under it. Every row carries the
// image it previews on `data-img` so the window never has to guess.
// Destination names stay in English in both languages: they are signage,
// and the meaning carries without translation.
const dest = [
  // modulo: the archive is the real project list and grows a folder at a
  // time, so it must never be indexed past its own length
  { href: '/works', name: 'Works', code: 'IX', img: archive[0 % archive.length].plate },
  { href: '/about', name: 'About', code: 'ST', img: archive[2 % archive.length].plate },
  { href: '/contact', name: 'Contact', code: 'CO', img: archive[4 % archive.length].plate },
];
const recent = archive.slice(0, 6);
---
<div class="mn" id="menu" inert aria-label="Menu">
  <div class="mn__inner">
    <div class="mn__head u-data">
      <span>Index</span>
      <button class="mn__close" type="button">
        Close
      </button>
    </div>

    <nav class="mn__list" aria-label="Pages">
      {dest.map((d) => (
        <a class="mn__row" href={d.href} data-img={d.img}>
          <span class="mn__code u-data">{d.code}</span>
          <span class="mn__word">{d.name}</span>
        </a>
      ))}
    </nav>

    <div class="mn__foot">
      <p class="mn__label u-data">Recent</p>
      <ul class="mn__recent">
        {recent.map((it) => (
          <li>
            <a class="mn__row mn__row--sm" href={`/archive/${it.slug}/`} data-img={it.plate}>
              <span class="u-data">{it.no}/</span>
              <span>{it.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <figure class="mn__win" aria-hidden="true"><img alt="" decoding="async" /></figure>
</div>

<style>
  .mn {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-curtain) - 10);
    background: var(--color-paper);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.42s ease, visibility 0.42s;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mn.is-open { opacity: 1; visibility: visible; }

  .mn__inner {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 18px var(--pad-inline) 26px;
  }
  .mn__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-soft);
  }
  .mn__close:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* ——— the destinations, in display size ——— */
  .mn__list {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(30px, 6vh, 70px) 0;
  }
  .mn__row {
    display: flex;
    align-items: baseline;
    gap: clamp(12px, 2vw, 30px);
    padding: clamp(4px, 1vh, 12px) 0;
    color: var(--color-ink);
    opacity: 0.42;
    transition: opacity 0.25s ease;
  }
  .mn__row:hover,
  .mn__row:focus-visible { opacity: 1; }
  .mn__code { opacity: 0.6; }
  .mn__word {
    font-size: clamp(46px, 11vw, 168px);
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  /* ——— the recent index ——— */
  .mn__foot { padding-top: 18px; border-top: 1px solid var(--line-soft); }
  .mn__label { opacity: 0.55; margin-bottom: 10px; }
  .mn__recent {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px 24px;
  }
  .mn__row--sm {
    font-size: 12px;
    gap: 10px;
    padding: 3px 0;
    opacity: 0.55;
  }

  /* ——— the following window ——— */
  .mn__win {
    position: fixed;
    top: 0;
    left: 0;
    width: clamp(170px, 17vw, 260px);
    aspect-ratio: 4 / 5;
    overflow: clip;
    background: var(--ink-04);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }
  .mn__win.is-on { opacity: 1; }
  .mn__win img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 760px) {
    .mn__recent { grid-template-columns: 1fr 1fr; }
    /* the window tracks a pointer that does not exist on touch */
    .mn__win { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mn, .mn__row, .mn__win { transition: none; }
  }
</style>

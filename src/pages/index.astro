---
import Base from '../layouts/Base.astro';
import archive from '../data/archive.json';

// Top — the strip. A contiguous vertical column of frames scrolling under a
// fixed viewport, flanked by two columns of project names. Measured from the
// reference at 1440x810: images fit a span-3 x 40vh box at their true aspect,
// stacked edge to edge; the ragged silhouette is a product of the pictures
// themselves, not of any effect applied to them. Nothing is cropped, scaled
// off-aspect or warped — the pictures are the product.
//
// The front page carries a selection of twelve; the full catalogue is /works.
// the strip loops, so it simply carries whatever the archive holds
const feature = archive;
---
<Base>
  <main class="tp" id="topStage">
    <!-- the strip itself -->
    <div class="tp__strip">
      {feature.map((it, i) => (
        <a
          class="tp__card"
          href={`/archive/${it.slug}/`}
          data-aspect={it.aspect}
          data-i={i}
          data-no={it.no}
          data-title={it.title}
          aria-label={it.title}
        >
          <figure class="tp__fig" data-frame>
            <img
              src={it.plate}
              alt={it.title}
              width={it.plateW}
              height={it.plateH}
              loading={i < 5 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
          <span class="tp__crop" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <!-- Only the project on the centre line is named, on the left. The two
         faces take turns: the outgoing one rolls up and away while the next
         rolls in from below, one turn of a die. -->
    <a class="tp__meta" id="tpMeta" href={`/archive/${feature[0].slug}/`}>
      <span class="tp__flip" data-dir="fwd">
        <span class="tp__face" data-face="0"></span>
        <span class="tp__face" data-face="1"></span>
      </span>
    </a>

    <!-- the opening: one small square on the centre line, which fills, then
         stretches into a row of thumbnails, which then grow into the strip -->
    <span class="tp__dot" aria-hidden="true"></span>

    <!-- pointer mark, inverted against whatever is under it -->
    <div class="tp__cross" aria-hidden="true">
      <span class="tp__crossBox"></span>
      <span class="tp__crossLabel">Open project</span>
    </div>

  </main>

  <!-- On a phone the document scrolls for real and this is what it scrolls
       against; the script sizes it. It must stay OUTSIDE the fixed stage —
       inside one it could never give the document any height. -->
  <div class="tp__run" aria-hidden="true"></div>
</Base>

<style>
  /* Desktop: the page owns the viewport and the strip scrolls inside it.
     Phone: the document scrolls natively and drives the strip sideways, so
     the stage is a fixed window over a real runway. */
  .tp {
    position: fixed;
    inset: 0;
    /* matches the visualViewport height the script measures with; plain vh
       would be the toolbar-collapsed maximum and the two would disagree */
    height: 100dvh;
    /* ⚠️ NOT decorative. iOS Safari fills its toolbar and safe areas from a
       viewport-edge position:fixed element's background-color in preference
       to the body's — and a transparent one gives it nothing to sample, so
       it falls back to its own dark canvas. Every other page has no
       full-viewport fixed element, which is why the black bands survived
       here alone. Stating the paper colour is the fix. */
    background: var(--color-paper);
    overflow: clip;
    touch-action: none;
    cursor: default;
  }
  .tp__run { height: 0; }

  /* ——— strip ——— */
  .tp__strip {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 100%;
    z-index: var(--z-stage);
  }
  .tp__card {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    will-change: transform;
  }
  /* The frame clips; the picture inside is taller than the frame and slides
     against it as the frame crosses the viewport. Measured off the
     reference: the content lags the frame by ~10% of its travel. */
  .tp__fig {
    /* driven by app.js on the way out — see closeFrames */
    clip-path: inset(0 0 var(--cut, 0%) 0);
    /* the placeholder wash belongs HERE, not on the card: on the parent it
       survives the clip and leaves a grey rectangle where the picture just
       closed */
    background: var(--ink-04);
    position: relative;
    width: 100%;
    height: 100%;
    overflow: clip;
  }
  .tp__fig img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: block;
    object-fit: cover;
    will-change: transform;
  }
  .tp__crop { display: none; }
  /* keyboard users get the same affordance the crosshair gives the mouse */
  .tp__card:focus-visible { outline: 1.5px solid var(--color-ink); outline-offset: 4px; }

  /* ——— the name of whatever is on the centre line ———
     Left column of the same 12-column grid, sitting on the centre line so it
     reads level with the picture it names. */
  .tp__meta {
    position: absolute;
    top: 50%;
    left: var(--pad-inline);
    width: 34vw;
    transform: translateY(-50%);
    z-index: calc(var(--z-stage) + 1);
    color: var(--color-ink);
  }
  .tp__flip {
    display: block;
    position: relative;
    /* The box the faces turn inside. line-height 1 on purpose: any leading
       is empty space that rotates with the face, and the turn reads as a
       taller block tumbling rather than the words themselves. */
    height: 1em;
    font-size: clamp(14px, 1.5vw, 22px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    perspective: 620px;
    transform-style: preserve-3d;
  }
  .tp__face {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 0.7em;
    align-items: center;
    white-space: nowrap;
    backface-visibility: hidden;
    transform-origin: 50% 50%;
    /* resting face */
    transform: translateY(0) rotateX(0deg);
    opacity: 1;
    transition: transform 0.62s cubic-bezier(0.45, 0, 0.15, 1),
                opacity 0.62s cubic-bezier(0.45, 0, 0.15, 1);
  }
  /* Scrolling forward: the face leaving rolls up over the top edge and the
     next one comes up from below. */
  .tp__face[data-state='out'] { transform: translateY(-100%) rotateX(90deg); opacity: 0; }
  /* the waiting face is placed without a transition — it is a reset, not a move */
  .tp__face[data-state='wait'] {
    transform: translateY(100%) rotateX(-90deg);
    opacity: 0;
    transition: none;
  }
  /* Scrolling back turns the die the other way, so the type moves with the
     hand rather than against it. */
  .tp__flip[data-dir='back'] .tp__face[data-state='out'] {
    transform: translateY(100%) rotateX(-90deg);
  }
  .tp__flip[data-dir='back'] .tp__face[data-state='wait'] {
    transform: translateY(-100%) rotateX(90deg);
  }
  .tp__faceNo { opacity: 0.55; }

  /* ——— pointer mark ——— */
  .tp__cross {
    position: fixed;
    top: 0;
    left: 0;
    z-index: calc(var(--z-header) - 1);
    pointer-events: none;
    opacity: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    mix-blend-mode: difference;
    color: #fff;
    will-change: transform;
  }
  .tp__crossBox { width: 8px; height: 8px; border: 1px solid #fff; display: block; }
  .tp__crossLabel {
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ——— the opening ———
     A single filled square waits on the centre line while the first frames
     decode, then hands over to the thumbnails (which the script animates). */
  .tp__dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    background: var(--color-ink);
    z-index: calc(var(--z-stage) + 2);
    /* it sits dead centre and outlives the opening at opacity 0, where it
       was still swallowing clicks — which is exactly where the centred
       frame is, so the most obvious thing to click was the one that did
       nothing */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  /* ⚠️ The opening's states are applied as INLINE styles by top.js, never as
     classes. Astro's scoped-CSS pass drops rules for classes that never
     appear in the template markup (verified: a `.tp.is-opening .tp__row`
     rule was absent from every stylesheet while the element matched the
     selector), so a class added at runtime by script finds no styling. */
  .tp__card { opacity: 1; transition: opacity 0.3s ease; }
  .tp__meta { transition: opacity 0.5s ease; }

  /* ——— phone: the strip lies down and native scroll drives it ——— */
  @media (max-width: 767px) {
    .tp {
      position: fixed;
      touch-action: auto;   /* the document scroll is the input now */
    }
    .tp__run { position: relative; z-index: -1; }
    .tp__strip { left: 0; width: 100%; }
    .tp__cross { display: none; }
    /* the name reads as a caption to the strip on a phone, so it sits
       centred under it rather than hanging off the left edge */
    .tp__meta {
      top: auto;
      bottom: calc(20px + env(safe-area-inset-bottom, 0px));
      left: 0;
      right: 0;
      width: auto;
      transform: none;
      text-align: center;
    }
    .tp__flip { font-size: 12px; }
    .tp__face { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp__card { transition: none !important; }
    /* a die turning is the whole idea, so reduced motion gets a plain cut */
    .tp__face { transition: opacity 0.001s !important; transform: none !important; }
    .tp__face[data-state='out'],
    .tp__face[data-state='wait'] { opacity: 0; transform: none !important; }
  }
</style>

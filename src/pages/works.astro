---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';
import archive from '../data/archive.json';
// Works — the catalogue index, rebuilt 2026-08-14 against the NAKORNSANG
// reference. The rules are strict and few:
//   1. A fixed column width (5 up on desktop, 2 on mobile). Every image in a
//      column is exactly as wide as the column.
//   2. Height follows the image's true aspect ratio, so nothing is cropped or
//      warped. Rows therefore end ragged at the bottom — that is the look.
//   3. Images hang from a shared top line per row. CSS grid gives us that for
//      free: each cell is a top-aligned block, so every figure in a row starts
//      at the same y, and the caption sits under its own image.
//   4. Almost no text: a running number, the title, the year. Nothing else.
const EAGER_COUNT = 8; // first screenful loads eagerly, the rest lazily
---
<Base title="Works — Pyrenees Pictures Studio">
  <main class="page-wrapper works">
    <header class="works__head">
      <h1 class="u-page works__title">Works</h1>
    </header>

    <ul class="works__grid">
      {archive.map((it, i) => (
        <li class="works__item">
          <a
            class="works__cell"
            data-work-link
            href={`/archive/${it.slug}/`}
            aria-label={`${it.title}, ${it.year}`}
          >
            {/* The figure box is sized from the true aspect, never cropped. */}
            <figure class="works__fig" data-frame style={`--aspect:${it.aspect}`}>
              <img
                src={it.image}
                alt={it.title}
                width={it.width}
                height={it.height}
                loading={i < EAGER_COUNT ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
            <p class="works__cap">
              <span class="u-data works__no">{it.no}</span>
              <span class="works__name">{it.title}</span>
              <span class="u-data works__year">{it.year}</span>
            </p>
          </a>
        </li>
      ))}
    </ul>

  </main>

  <SiteFooter />
</Base>

<style>
  .page-wrapper { padding-inline: var(--pad-inline); }
  .works {
    padding-top: 96px;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  /* ——— header: the one big thing on the page ——— */
  .works__head { padding-bottom: clamp(14px, 2vh, 22px); }
  .works__title { margin: 0; }

  /* ——— the XY grid ———
     Fixed column count per breakpoint => fixed column width. `align-items:
     start` keeps every cell hanging from the row's top line; the differing
     figure heights then leave the row ragged at the bottom, as intended. */
  .works__grid {
    margin-top: clamp(28px, 5vh, 64px);
    margin-bottom: clamp(48px, 9vh, 120px);
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: start;
    column-gap: clamp(12px, 1.4vw, 22px);
    row-gap: clamp(36px, 5vh, 68px);
  }
  .works__item { min-width: 0; }
  .works__cell { display: block; }

  .works__fig {
    /* driven by app.js on the way out — see closeFrames */
    clip-path: inset(0 0 var(--cut, 0%) 0);
    margin: 0;
    aspect-ratio: var(--aspect, 1.4);
    overflow: clip;
    background: var(--ink-04);
  }
  .works__fig img {
    display: block;
    width: 100%;
    height: 100%;
    /* The box already matches the source ratio, so `cover` never crops here;
       it only guards against sub-pixel rounding. */
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 0.8, 0.24, 1);
  }
  .works__cell:hover .works__fig img { transform: scale(0.985); }

  /* ——— caption: number, title, year. Nothing more. ——— */
  .works__cap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 12px;
  }
  .works__no { color: var(--color-ink); opacity: 0.56; }
  .works__name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--fs-micro);
    line-height: 1.3;
  }
  .works__year {
    margin-left: auto;
    color: var(--color-ink);
    opacity: 0.56;
  }


  /* 5 up (PC) -> 4 -> 3 (tablet) -> 2 (SP) */
  @media (max-width: 1200px) {
    .works__grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 900px) {
    .works__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 620px) {
    .works { padding-top: 72px; }
    .works__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 34px;
    }
    .works__cap { flex-wrap: wrap; gap: 6px; }
    .works__year { margin-left: 0; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';
import archive from '../data/archive.json';
// Works — the catalogue index, rebuilt 2026-08-14 against the NAKORNSANG
// reference. The rules are strict and few:
//   1. A fixed column width (4 up on desktop, 2 on mobile). Every image in a
//      column is exactly as wide as the column.
//   2. Height follows the image's true aspect ratio, so nothing is cropped or
//      warped. Rows therefore end ragged at the bottom — that is the look.
//   3. Images hang from a shared top line per row. CSS grid gives us that for
//      free: each cell is a top-aligned block, so every figure in a row starts
//      at the same y, and the caption sits under its own image.
//   4. Almost no text: a running number, the title, the year. Nothing else.
//   5. One cell per row is left EMPTY and stays empty — the grid does not
//      close up around it. Which one is picked per row is arbitrary but
//      fixed: a seeded hash rather than Math.random, so the page does not
//      reshuffle itself on every build and the diffs stay readable.
const EAGER_COUNT = 8; // first screenful loads eagerly, the rest lazily
const COLS = 4;
const blankFor = (row) => {
  const n = Math.sin(row * 12.9898 + 4.1414) * 43758.5453;
  return Math.min(COLS - 1, Math.floor((n - Math.floor(n)) * COLS));
};
// lay the entries into rows, dropping a hole into each
const cells = [];
for (let i = 0, row = 0; i < archive.length; row++) {
  const hole = blankFor(row);
  for (let c = 0; c < COLS; c++) {
    cells.push(c === hole || i >= archive.length ? null : archive[i++]);
  }
}
---
<Base title="Image Creation — Pyrenees Pictures Studio">
  <main class="page-wrapper works">
    <header class="works__head">
      <h1 class="u-page works__title">Image Creation</h1>
    </header>

    <ul class="works__grid">
      {cells.map((it, i) => (it === null ? (
        <li class="works__item works__item--gap" aria-hidden="true"></li>
      ) : (
        <li class="works__item">
          <a
            class="works__cell"
            data-work-link
            href={`/archive/${it.slug}/`}
            aria-label={`${it.title}, ${it.year}`}
          >
            {/* The figure box is sized from the true aspect, never cropped. */}
            <figure class="works__fig" data-frame style={`--aspect:${it.aspect}`}>
              <img
                src={it.image}
                alt={it.title}
                width={it.width}
                height={it.height}
                loading={i < EAGER_COUNT ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
            <p class="works__cap">
              <span class="u-data works__no">{it.no}</span>
              <span class="works__name">{it.title}</span>
              <span class="u-data works__year">{it.year}</span>
            </p>
          </a>
        </li>
      )))}
    </ul>

  </main>

  <SiteFooter />
</Base>

<style>
  .page-wrapper { padding-inline: var(--pad-inline); }
  .works {
    padding-top: 96px;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  /* ——— header: the one big thing on the page ——— */
  .works__head { padding-bottom: 0; }
  .works__title { margin: 0; }

  /* ——— the XY grid ———
     Fixed column count per breakpoint => fixed column width. `align-items:
     start` keeps every cell hanging from the row's top line; the differing
     figure heights then leave the row ragged at the bottom, as intended. */
  .works__grid {
    margin-top: 30px;
    margin-bottom: clamp(48px, 9vh, 120px);
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
    /* One gap in both directions. The rows used to be far deeper than the
       columns to leave room for a caption under each picture; with the
       captions off that space reads as the grid coming apart. Restore the
       taller row-gap alongside the .works__cap rule below. */
    gap: clamp(12px, 1.4vw, 22px);
  }
  .works__item { min-width: 0; }
  .works__cell { display: block; }

  .works__fig {
    /* driven by app.js on the way out — see closeFrames */
    clip-path: inset(0 0 var(--cut, 0%) 0);
    margin: 0;
    aspect-ratio: var(--aspect, 1.4);
    overflow: clip;
    background: var(--ink-04);
  }
  .works__fig img {
    display: block;
    width: 100%;
    height: 100%;
    /* The box already matches the source ratio, so `cover` never crops here;
       it only guards against sub-pixel rounding. */
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 0.8, 0.24, 1);
  }
  .works__cell:hover .works__fig img { transform: scale(0.985); }

  /* ——— caption: number, title, year. Nothing more. ——— */
  .works__cap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 14px;
  }
  /* Captions are off for now (trying the index as pictures alone). The
     markup stays — each link already carries the title and year in its
     aria-label and the image alt, so a screen reader loses nothing. Delete
     this one rule to bring the text back. */
  .works__cap { display: none; }
  .works__no { color: var(--color-ink); opacity: 0.56; }
  .works__name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--fs-micro);
    line-height: 1.3;
  }
  .works__year {
    margin-left: auto;
    color: var(--color-ink);
    opacity: 0.56;
  }


  /* 5 up (PC) -> 4 -> 3 (tablet) -> 2 (SP) */
  /* a hole in a two-column grid costs half a row, so phones run dense */
  @media (max-width: 900px) {
    .works__item--gap { display: none; }
  }
  @media (max-width: 620px) {
    .works { padding-top: 100px; }
    .works__grid {
      grid-template-columns: repeat(2, 1fr);
      /* edge to edge on a phone: out of the wrapper's inline padding and
         across the viewport. 50% - 50vw rather than a raw 100vw so a
         scrollbar cannot push it sideways. */
      width: 100vw;
      margin-left: calc(50% - 50vw);
      gap: 5px;
    }
    .works__cap { flex-wrap: wrap; gap: 6px; }
    .works__year { margin-left: 0; }
  }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Pyrenees Pictures Studio">
  <main class="page-wrapper nf">
    <h1 class="nf__code u-display">404.</h1>
    <p class="nf__line">This page is not on the menu.</p>
    <a class="nf__back" href="/">&larr; Back to the archive</a>
  </main>
</Base>

<style>
  .page-wrapper { padding-inline: var(--pad-inline); }
  .nf {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
  }
  .nf__code { font-size: clamp(64px, 12vw, 180px); }
  .nf__line { color: var(--color-grey-d); font-size: 16px; }
  .nf__back {
    width: fit-content;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }
  .nf__back:hover { color: var(--color-ink); }
</style>
